{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": [
    "src/deps/astro",
    "src/scripts/detect-ai-text",
    "src/scripts/download-paper-files",
    "src/scripts/fetch-oparl",
    "src/scripts/generate-oparl-derivatives",
    "src/scripts/generate-paper-assets",
    "src/scripts/generate-paper-votings",
    "src/scripts/index-search",
    "src/scripts/parse-speakers",
    "src/scripts/scan-voting-images",
    "src/scripts/scrape-oparl",
    "src/scripts/shared",
    "src/scripts/speech-to-text"
  ]
}
